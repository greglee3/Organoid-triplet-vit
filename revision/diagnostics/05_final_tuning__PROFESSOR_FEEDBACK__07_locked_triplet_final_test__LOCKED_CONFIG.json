  "weight_decay": 0.01,
  "warmup_epochs": 2,
  "scheduler": "cosine",
  "early_stopping": false,
  "checkpoint_rule": "maximize validation macro-F1; tie: lower total loss",
  "augmentation": "paper",
  "triplet_ce_only_epochs": 0,
  "triplet_ramp_epochs": 0,
  "ensemble_rule": "mean of five fold softmax probability vectors",
  "primary_metric": "macro_f1",
  "safety_metrics": [
    "c_recall",
    "c_precision",
    "c_specificity",
    "c_to_a",
    "c_to_b"
